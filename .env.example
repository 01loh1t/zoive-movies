# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# TMDB: themoviedb.org -> Settings -> API -> "API Read Access Token" (the long one)
# Server-only: never exposed to the browser.
TMDB_READ_TOKEN=

# Supabase: your project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's public address (used for sign-in redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
